      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "P0941905C0D8205B6"
          },
          "queryText": "WITH ch AS (SELECT * FROM charges WHERE id = (SELECT id FROM charges ORDER BY id DESC LIMIT 1)), dur AS (SELECT MAX((julianday(ch.ended_at)-julianday(ch.started_at))*1440.0/60.0, 1.0) as bin_min FROM ch) SELECT CAST((julianday(p.recorded_at) - julianday(ch.started_at)) * 1440 / (SELECT bin_min FROM dur) AS INT) || '' as minuti, ROUND(AVG(ABS(p.charge_voltage_v * p.charge_current_a)/1000.0),3) as kW FROM positions p, ch WHERE p.charging = 1 AND p.recorded_at >= ch.started_at AND p.recorded_at <= COALESCE(ch.ended_at, datetime('now')) GROUP BY CAST((julianday(p.recorded_at) - julianday(ch.started_at)) * 1440 / (SELECT bin_min FROM dur) AS INT) ORDER BY MIN(p.recorded_at)",
          "queryType": "table",
          "rawQueryText": "WITH ch AS (SELECT * FROM charges WHERE id = (SELECT id FROM charges ORDER BY id DESC LIMIT 1)), dur AS (SELECT MAX((julianday(ch.ended_at)-julianday(ch.started_at))*1440.0/60.0, 1.0) as bin_min FROM ch) SELECT CAST((julianday(p.recorded_at) - julianday(ch.started_at)) * 1440 / (SELECT bin_min FROM dur) AS INT) || '' as minuti, ROUND(AVG(ABS(p.charge_voltage_v * p.charge_current_a)/1000.0),3) as kW FROM positions p, ch WHERE p.charging = 1 AND p.recorded_at >= ch.started_at AND p.recorded_at <= COALESCE(ch.ended_at, datetime('now')) GROUP BY CAST((julianday(p.recorded_at) - julianday(ch.started_at)) * 1440 / (SELECT bin_min FROM dur) AS INT) ORDER BY MIN(p.recorded_at)",
          "refId": "A",
          "timeColumns": []
        }
      ],
      "title": "Potenza di ricarica (kW, lato batteria)",
      "type": "barchart"
