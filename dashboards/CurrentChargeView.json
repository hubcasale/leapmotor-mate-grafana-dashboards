          "queryType": "table",
          "rawQueryText": "WITH ch AS (SELECT * FROM charges WHERE id = (SELECT id FROM charges ORDER BY id DESC LIMIT 1)), dur AS (SELECT MAX((julianday(ch.ended_at)-julianday(ch.started_at))*1440.0/60.0, 1.0) as bin_min FROM ch) SELECT CAST((julianday(p.recorded_at) - julianday(ch.started_at)) * 1440 / (SELECT bin_min FROM dur) AS INT) || '' as minuti, ROUND(AVG(p.soc),1) as soc FROM positions p, ch WHERE p.charging = 1 AND p.recorded_at >= ch.started_at AND p.recorded_at <= COALESCE(ch.ended_at, datetime('now')) GROUP BY CAST((julianday(p.recorded_at) - julianday(ch.started_at)) * 1440 / (SELECT bin_min FROM dur) AS INT) ORDER BY MIN(p.recorded_at)",
